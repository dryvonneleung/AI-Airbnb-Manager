# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# @supabase/server SDK (server-side auth + client creation)
# Copy these from the Supabase dashboard's "Connect" dialog.
# Single-key forms (shown here) are accepted; the SDK also supports the named
# JSON forms SUPABASE_PUBLISHABLE_KEYS / SUPABASE_SECRET_KEYS and inline
# SUPABASE_JWKS. On Supabase Edge Functions these are injected automatically.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Browser/SSR publishable key (new naming). The adapter falls back to
# NEXT_PUBLIC_SUPABASE_ANON_KEY above if this is unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform admin (dispute notifications)
ADMIN_EMAIL=admin@cleanrus.com
